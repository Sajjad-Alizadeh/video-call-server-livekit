HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Backend-only bearer key. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BACKEND_API_KEY=
# Independent server-only secret for signing invitation codes (at least 32 characters).
INVITE_SIGNING_SECRET=
# Host access key for generating invitations from React. Enter manually; never bundle it.
INVITE_CREATOR_KEY=


# URL used by the Node.js SDK to call the LiveKit server APIs.
LIVEKIT_URL=http://127.0.0.1:7880
# URL reachable by participants (use wss:// with a trusted certificate on Ubuntu).
LIVEKIT_WS_URL=ws://127.0.0.1:7880

# These match `livekit-server --dev`. Local development only.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
